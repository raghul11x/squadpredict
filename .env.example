# SquadPredict Environment Configuration
# Copy this file to .env and fill in your values

# Hugging Face API User Access Token (Free from https://huggingface.co/settings/tokens)
# Leave blank to use the built-in offline tactical reasoning engine
HF_TOKEN=your_huggingface_token_here

# Default Hugging Face Model for Tactical Scout Reporting
# Supported options:
# - google/gemma-3-12b-it
# - Qwen/Qwen2.5-72B-Instruct
# - meta-llama/Llama-3.3-70B-Instruct
# - Qwen/Qwen2.5-Coder-32B-Instruct
HF_MODEL=google/gemma-3-12b-it
